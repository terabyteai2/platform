{
  "framework": "nextjs",
  "buildCommand": "npm run db:generate && npm run build",
  "env": {
    "DATABASE_URL": "@voices-database-url",
    "SUPABASE_URL": "@voices-supabase-url",
    "SUPABASE_SERVICE_ROLE_KEY": "@voices-supabase-service-role-key",
    "DEEPGRAM_API_KEY": "@voices-deepgram-api-key",
    "SPEECHMATICS_API_KEY": "@voices-speechmatics-api-key",
